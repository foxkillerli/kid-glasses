{
  "name": "kid-glasses",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "npm run build && evenhub pack app.json dist --sdk-ver 0.0.16 -o kid-glasses.ehpk",
    "simulate": "evenhub-simulator http://localhost:5173 --automation-port 9898",
    "qr": "evenhub qr --url https://kid-glasses-m0.your-subdomain.workers.dev"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.2.0",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "@evenrealities/pretext": "0.1.4",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
